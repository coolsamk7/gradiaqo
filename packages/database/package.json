{
  "name": "@studylog/database",
  "version": "0.0.0",
  "private": true,
  "description": "TypeORM entities shared by Gradiaqo backend apps, and the importer for official learning-path files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fake-manager.d.ts",
      "default": "./dist/testing/fake-manager.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "typebox": "^1.3.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@studylog/common": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.11.0",
    "typebox": "^1.3.34",
    "typeorm": "^1.1.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@studylog/schemas": "workspace:*",
    "yaml": "^2.6.1"
  }
}
