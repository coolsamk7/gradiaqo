{
  "name": "@studylog/database",
  "version": "0.0.0",
  "private": true,
  "description": "TypeORM entities shared by StudyLog backend apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix"
  },
  "peerDependencies": {
    "typebox": "^1.3.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@studylog/common": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typebox": "^1.3.34",
    "typeorm": "^1.1.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@studylog/schemas": "workspace:*"
  }
}
