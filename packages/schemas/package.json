{
  "name": "@studylog/schemas",
  "version": "0.0.0",
  "private": true,
  "description": "StudyLog API contract as TypeBox schemas: request/response shapes, their TypeScript types, and role enums. No framework dependencies, so web and mobile apps can share it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "typebox": "^1.3.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@studylog/common": "workspace:*",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.11.0",
    "typebox": "^1.3.34",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
