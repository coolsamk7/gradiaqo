# development | production | test. production requires COOKIE_SECURE=true.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://studylog:studylog@localhost:5432/studylog
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=180
# true in production (HTTPS only)
COOKIE_SECURE=false
# Number of reverse proxies (load balancer, CDN) in front of the API, so rate limits and logs see the
# real client IP. 0 when reached directly. Never set it higher than the real number of proxies.
TRUST_PROXY=0
# Browser apps allowed to call the API: exact origins, comma-separated (no * or trailing slash).
# Empty: no cross-origin access. Production example: https://app.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Serve API docs at /docs. Keep false in production.
SWAGGER_ENABLED=true
# trace | debug | info | warn | error
LOG_LEVEL=info
# Readable colored logs locally; false in production (JSON for log tools)
LOG_PRETTY=false
# Rate limits per client IP (see src/rate-limits.ts). Only the UI tests (apps/e2e) turn them off; never off in production.
RATE_LIMITS_ENABLED=true
# Outgoing email (verification and password-reset codes). Locally: Mailpit from `yarn db:up`; see what was sent
# at http://localhost:8025. Production: the provider's SMTP relay, e.g. Brevo: smtp-relay.brevo.com, port 587,
# your Brevo login as SMTP_USER and an SMTP key as SMTP_PASSWORD. MAIL_FROM must be on a domain verified there.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=StudyLog <no-reply@studylog.local>
