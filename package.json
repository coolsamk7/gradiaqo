{
  "name": "gradioqo",
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/shared/*",
    "packages/nestjs/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "prepare": "husky",
    "lint": "eslint"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "eslint --max-warnings=500"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.39.0",
    "@gradiaqo/eslintconfig": "workspace:^",
    "@hey-api/openapi-ts": "^0.96.0",
    "@types/k6": "^1.4.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
