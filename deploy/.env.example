# Production settings. Copy to deploy/.env on the server (never commit it) and fill in every value.

# The address people open, without https:// — your domain, or a free one from sslip.io:
# a server at 140.238.1.2 is reachable as 140-238-1-2.sslip.io (Caddy gets a certificate for it too).
DOMAIN=studylog.example.com

# Database password, letters and digits only (it goes into a URL): openssl rand -hex 32
POSTGRES_PASSWORD=
# Signs access tokens, at least 32 characters: openssl rand -base64 48
JWT_SECRET=

# Optional; these defaults are fine.
POSTGRES_USER=studylog
POSTGRES_DB=studylog
