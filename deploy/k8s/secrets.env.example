# Production secrets. Copy to deploy/k8s/secrets.env on the server (chmod 600, never commit it) and fill in.

# Database password, letters and digits only (it goes into a URL): openssl rand -hex 32
POSTGRES_PASSWORD=
# Signs access tokens, at least 32 characters: openssl rand -base64 48
JWT_SECRET=

# The email provider's SMTP login (Brevo: Settings → SMTP & API).
SMTP_USER=
SMTP_PASSWORD=
