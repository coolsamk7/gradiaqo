# Production settings that aren't secret. Copy to deploy/k8s/config.env on the server and fill in.
# Every setting the API reads is listed in apps/api/src/config/env.ts.

# The address people open, without https://: your domain, or a free one from sslip.io
# (a server at 140.238.1.2 is reachable as 140-238-1-2.sslip.io). Also the Ingress host and certificate name.
DOMAIN=studylog.example.com
# The same address with https://, for links in emails.
APP_URL=https://studylog.example.com

# Outgoing email: the provider's SMTP relay (Brevo here); its login goes in secrets.env.
SMTP_HOST=smtp-relay.brevo.com
# 2525, not the usual 587: cloud providers (Civo among them) block the mail ports 25, 465 and 587 going out.
# Brevo takes 2525 the same way, encrypted with STARTTLS.
SMTP_PORT=2525
MAIL_FROM=StudyLog <no-reply@studylog.example.com>

NODE_ENV=production
PORT=3000
COOKIE_SECURE=true
# Two proxies in front of the API: Traefik, then Caddy in the web pod.
TRUST_PROXY=2
SWAGGER_ENABLED=false
LOG_LEVEL=info
