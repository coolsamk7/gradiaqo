# Backup settings. Copy to deploy/k8s/backup/backup.env (never commit it) and fill in.

# Encrypts every backup before it leaves the cluster. Keep a copy outside the server (a password manager): without
# it the backups can't be restored. Generate one with: openssl rand -base64 32
BACKUP_PASSWORD=
# A second password for rclone's crypt (the "salt"), kept with the first: openssl rand -base64 32
BACKUP_SALT=

# Optional: a URL to call after each successful backup, e.g. a free check on healthchecks.io that emails you when a
# night's call doesn't arrive (so a backup that silently stops running gets noticed). Leave empty to skip.
BACKUP_PING_URL=
